# From @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (comma-separate to allow more people).
# Leave empty on first run: message the bot and it will tell you your id.
ALLOWED_USER_IDS=

# LLM (DeepSeek via OpenRouter) — understands any message, plans country-wide searches,
# translates your pitch. Without it the bot only understands "<niche> in <location>".
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Search provider — set ONE of these keys:
# serper.dev (no Google Cloud account/card needed)
SERPER_API_KEY=
# or Google Cloud key with "Places API (New)" enabled
# GOOGLE_PLACES_API_KEY=

# Website previews (🎨 Mockup) — served by the bot itself, no LLM.
# On Railway, generate a domain for the service and RAILWAY_PUBLIC_DOMAIN is picked up automatically.
# PUBLIC_URL=https://your-bot.up.railway.app
# MOCKUP_BRAND=Your Studio Name        # shown on previews ("made by …")
# MOCKUP_BRAND_URL=https://wa.me/4860… # optional link on your brand (e.g. your WhatsApp)

# Daily digest (follow-ups due, hot leads, yesterday's numbers). /digest sends one on demand.
# DIGEST_TZ=Africa/Lagos      # any IANA timezone
# DIGEST_TIME=09:00
# FOLLOWUP_DAYS=3             # wait this long for a reply before each follow-up

# Optional
# PLACES_PROVIDER=serper      # force a provider if both keys are set: serper | google
# DEFAULT_RESULTS=20          # one city
# DEFAULT_WIDE_RESULTS=60     # a whole country / region
# ODIFY_DB=data/odify.db
# PLACES_API_MODE=auto        # google only: auto | new | legacy
# EMAIL_LOOKUP=on             # off = skip the (slow, best-effort) email hunt
# EMAIL_SEARCH_BACKENDS=yahoo,bing   # engines used for the email hunt (ddgs backends)
